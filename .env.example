# Somente desenvolvimento local. Nunca publique credenciais reais.
DB_PASSWORD=pelada-local
# Para iniciar Java fora do Compose:
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/pelada
DB_USER=pelada
COOKIE_SECURE=false
DEMO_ENABLED=true
# Recuperação de senha: chave da API transacional do Brevo (HTTPS).
# Nunca coloque a chave real no Git. Sem configuração completa, o envio fica indisponível.
BREVO_API_KEY=
MAIL_FROM=
PUBLIC_APP_URL=http://localhost:8080
# Área de Administração: somente contas existentes e confiáveis. Vazio bloqueia o acesso.
ADMIN_EMAILS=

# Anonymous first-party visit counting. Disable collection with false.
VISIT_STATS_ENABLED=true

# Assistente: configure no backend. Modelo precisa suportar Structured Outputs.
# Desligado por padrão; a criação pelo formulário continua disponível.
ASSISTANT_ENABLED=false
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_DAILY_LIMIT=20
# WhatsApp: apenas vinculação e preferências nesta etapa; não envia mensagens.
WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
