# Somente desenvolvimento local. Nunca publique credenciais reais.
DB_PASSWORD=pelada-local
# Para iniciar Java fora do Compose:
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/pelada
DB_USER=pelada
COOKIE_SECURE=false
DEMO_ENABLED=true
# Recuperação de senha: chave da API transacional do Brevo (HTTPS).
# Nunca coloque a chave real no Git. Sem configuração completa, o envio fica indisponível.
BREVO_API_KEY=
MAIL_FROM=
PUBLIC_APP_URL=http://localhost:8080
# Área de Administração: somente contas existentes e confiáveis. Vazio bloqueia o acesso.
ADMIN_EMAILS=

# Anonymous first-party visit counting. Disable collection with false.
VISIT_STATS_ENABLED=true
