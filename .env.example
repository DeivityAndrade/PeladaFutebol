# Somente desenvolvimento local. Nunca publique credenciais reais.
DB_PASSWORD=pelada-local
# Para iniciar Java fora do Compose:
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/pelada
DB_USER=pelada
COOKIE_SECURE=false
DEMO_ENABLED=true
# Recuperação de senha: configure estes valores com as credenciais SMTP do provedor.
# Sem configuração completa, a API informa que a recuperação está indisponível.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
PUBLIC_APP_URL=http://localhost:8080
