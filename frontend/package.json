{
  "name": "pelada-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.json",
    "build": "ng build",
    "test:e2e": "playwright test",
    "format": "prettier --plugin=prettier-plugin-java --write \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\" \"*.{json,ts,yaml}\" \"../backend/src/**/*.java\"",
    "format:check": "prettier --plugin=prettier-plugin-java --check \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\" \"*.{json,ts,yaml}\" \"../backend/src/**/*.java\""
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@playwright/test": "^1.58.0",
    "prettier": "^3.9.8",
    "prettier-plugin-java": "^2.10.4",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@11.19.0"
}
