          }
        ],
        [
          {
            "node": "Concluir mensagem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Modelo econômico": {
      "ai_languageModel": [
        [
          {
            "node": "Agente do grupo",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Acionar sistema": {
      "ai_tool": [
        [
          {
            "node": "Agente do grupo",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Agente do grupo": {
      "main": [
        [
          {
            "node": "Garantir resposta do sistema",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Garantir resposta do sistema": {
      "main": [
        [
          {
            "node": "Concluir mensagem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Concluir mensagem": {
      "main": [
        [
          {
            "node": "Uma mensagem por vez",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 240,
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "timezone": "America/Sao_Paulo"
  }
}
