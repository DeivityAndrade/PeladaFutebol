    {
      "id": "td-node-6",
      "name": "Recebeu áudio?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        840,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Recebeu áudio?",
              "leftValue": "={{ $('Uma mensagem por vez').first(1).json.mediaUrl != null }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "td-node-7",
      "name": "Obter mídia da Meta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1020,
        -350
      ],
      "parameters": {
        "url": "={{ $('Uma mensagem por vez').first(1).json.mediaUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "todentro-meta",
          "name": "Meta — WhatsApp"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": false
    },
    {
      "id": "td-node-8",
      "name": "Validar mídia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        -350
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function validateMedia(media, expectedMime) {\n  const url = media.url;\n  const mime = String(media.mime_type || '').split(';')[0].toLowerCase();\n  if (typeof url !== 'string' || !/^https:\\/\\/(lookaside\\.fbsbx\\.com|graph\\.facebook\\.com)\\/whatsapp_business\\/attachments\\/[?][^\\s#]+$/.test(url))\n    throw new Error('Destino de mídia inválido.');\n  if (!Number.isInteger(media.file_size) || media.file_size <= 0 || media.file_size > 2 * 1024 * 1024)\n    throw new Error('O áudio deve ter até 2 MB.');\n  if (!['audio/ogg', 'audio/mp4', 'audio/m4a'].includes(mime) || mime !== String(expectedMime || '').split(';')[0].toLowerCase())\n    throw new Error('Formato de áudio inválido.');\n  return { url };\n}\nreturn { json: validateMedia($json, $('Uma mensagem por vez').first(1).json.mediaMime) };"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "td-node-9",
      "name": "Baixar áudio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1440,
        -350
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "todentro-meta",
          "name": "Meta — WhatsApp"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": false
    },
    {
      "id": "td-node-10",
      "name": "Transcrever áudio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1640,
        -350
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').first().json.backend + '/api/integrations/whatsapp/inbox/' + $('Uma mensagem por vez').first(1).json.id + '/audio' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "leaseId",
              "value": "={{ $('Uma mensagem por vez').first(1).json.leaseId }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 55000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "todentro-worker",
          "name": "Tô Dentro — integração"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": false
    },
    {
      "id": "td-node-11",
      "name": "Pedido em texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { mediaUrl, mediaMime, ...job } = $('Uma mensagem por vez').first(1).json; return { json: { ...job, text: $json.text ?? job.text } };"
      }
    },
    {
      "id": "td-node-12",
      "name": "Falha no áudio",
      "type": "n8n-nodes-base.httpRequest",
